<?xml version="1.0"?>
<!--
  base.xacro  -  mobile base + torso (pedestal).
  Parameters : base_radius, base_height, torso_radius, torso_height, wheel_radius
  Interface  : attaches to `parent`, exports the frame `arm_mount` (shoulder mounting point).
  The base is "mobile" through 3 virtual joints (x, y, yaw) that stand in for the drive system.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One wheel module; instantiated four times below (re-use through composition) -->
  <xacro:macro name="wheel_module" params="name parent x y radius width">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
      </collision>
      <xacro:add_cylinder_inertia mass="0.4" radius="${radius}" length="${width}" axis="y"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="mobile_base"
               params="parent base_radius base_height torso_radius torso_height wheel_radius:=0.05">

    <!-- derived numbers: everything is computed from the parameters -->
    <xacro:property name="torso_z0" value="${wheel_radius + base_height}"/>

    <!-- ===== virtual planar drive: world -> x -> y -> yaw -> base_link ===== -->
    <link name="base_x_link"/>
    <link name="base_y_link"/>

    <joint name="base_x_joint" type="prismatic">
      <parent link="${parent}"/>
      <child link="base_x_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-3.0" upper="3.0" effort="1000" velocity="1.0"/>
    </joint>

    <joint name="base_y_joint" type="prismatic">
      <parent link="base_x_link"/>
      <child link="base_y_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.0" upper="3.0" effort="1000" velocity="1.0"/>
    </joint>

    <joint name="base_yaw_joint" type="continuous">
      <parent link="base_y_link"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="500" velocity="1.5"/>
    </joint>

    <!-- ===== cylindrical body (frame on the floor, body starts above the wheels) ===== -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${wheel_radius + base_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${wheel_radius + base_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      </collision>
      <xacro:add_cylinder_inertia mass="20.0" radius="${base_radius}" length="${base_height}"
                               axis="z" cz="${wheel_radius + base_height/2}"/>
    </link>

    <!-- four wheels: same macro, four different positions -->
    <xacro:wheel_module name="wheel_fl" parent="base_link" x="${ 0.6*base_radius}" y="${ 0.8*base_radius}" radius="${wheel_radius}" width="0.04"/>
    <xacro:wheel_module name="wheel_fr" parent="base_link" x="${ 0.6*base_radius}" y="${-0.8*base_radius}" radius="${wheel_radius}" width="0.04"/>
    <xacro:wheel_module name="wheel_bl" parent="base_link" x="${-0.6*base_radius}" y="${ 0.8*base_radius}" radius="${wheel_radius}" width="0.04"/>
    <xacro:wheel_module name="wheel_br" parent="base_link" x="${-0.6*base_radius}" y="${-0.8*base_radius}" radius="${wheel_radius}" width="0.04"/>

    <!-- ===== torso / pedestal that lifts the shoulder to working height ===== -->
    <link name="torso_link">
      <visual>
        <origin xyz="0 0 ${torso_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${torso_radius}" length="${torso_height}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${torso_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${torso_radius}" length="${torso_height}"/></geometry>
      </collision>
      <xacro:add_cylinder_inertia mass="5.0" radius="${torso_radius}" length="${torso_height}"
                               axis="z" cz="${torso_height/2}"/>
    </link>

    <joint name="torso_joint" type="fixed">
      <parent link="base_link"/>
      <child link="torso_link"/>
      <origin xyz="0 0 ${torso_z0}" rpy="0 0 0"/>
    </joint>

    <!-- mounting frame for the arm: top of the torso -->
    <link name="arm_mount"/>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="torso_link"/>
      <child link="arm_mount"/>
      <origin xyz="0 0 ${torso_height}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
