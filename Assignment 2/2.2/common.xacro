<?xml version="1.0"?>
<!--
  common.xacro  -  shared building blocks (materials + inertia helper macros).
  Included first by robot.xacro; every other file re-uses these definitions.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== MATERIALS ===================== -->
  <material name="light_grey"><color rgba="0.78 0.78 0.80 1.0"/></material>
  <material name="dark_grey"><color rgba="0.25 0.25 0.28 1.0"/></material>
  <material name="blue"><color rgba="0.15 0.35 0.80 1.0"/></material>
  <material name="orange"><color rgba="0.95 0.50 0.10 1.0"/></material>
  <material name="red"><color rgba="0.85 0.10 0.10 1.0"/></material>
  <material name="white"><color rgba="0.95 0.95 0.95 1.0"/></material>
  <material name="wood"><color rgba="0.62 0.42 0.22 1.0"/></material>
  <material name="milk_white"><color rgba="0.92 0.94 1.00 1.0"/></material>
  <material name="mug_teal"><color rgba="0.10 0.60 0.60 1.0"/></material>
  <material name="glass"><color rgba="0.70 0.85 0.95 0.6"/></material>

  <!-- ===================== INERTIA MACROS ===================== -->
  <!-- Solid box of size x*y*z, centre of mass at (cx, cy, cz) -->
  <xacro:macro name="add_box_inertia" params="mass x y z cx:=0 cy:=0 cz:=0">
    <inertial>
      <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12.0*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${mass/12.0*(x*x+z*z)}" iyz="0"
               izz="${mass/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder whose symmetry axis is the link's x, y or z axis.
       (written with xacro:if blocks instead of a one-line "if/else" so that every xacro reader understands it) -->
  <xacro:macro name="add_cylinder_inertia" params="mass radius length axis:=z cx:=0 cy:=0 cz:=0">
    <xacro:property name="i_axial" value="${0.5*mass*radius*radius}"/>
    <xacro:property name="i_trans" value="${mass*(3*radius*radius+length*length)/12.0}"/>
    <xacro:if value="${axis == 'x'}">
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${i_axial}" ixy="0" ixz="0" iyy="${i_trans}" iyz="0" izz="${i_trans}"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${axis == 'y'}">
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${i_trans}" ixy="0" ixz="0" iyy="${i_axial}" iyz="0" izz="${i_trans}"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${axis == 'z'}">
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${i_trans}" ixy="0" ixz="0" iyy="${i_trans}" iyz="0" izz="${i_axial}"/>
      </inertial>
    </xacro:if>
  </xacro:macro>

</robot>
